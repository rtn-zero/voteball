# MongoDB Atlas connection string (Atlas > Connect > Drivers). Include the db name (/voteball).
MONGODB_URI=mongodb+srv://USER:PASS@cluster0.xxxxx.mongodb.net/voteball?retryWrites=true&w=majority

# Render injects PORT automatically in production; only needed for local runs.
PORT=3000

# Comma-separated allow-list of origins that may call the API.
# Leave blank locally to reflect any origin.
CORS_ORIGIN=https://voteball.pages.dev,http://localhost:8788

# Free API key from football-data.org (for `npm run sync`). Register at
# https://www.football-data.org/client/register
FOOTBALL_DATA_TOKEN=your_football_data_key
# Competition to sync. Default WC (FIFA World Cup).
FOOTBALL_DATA_COMP=WC
